@{
    Layout = "_Layout";
}

<!-- Hero Start -->
<div class="container-fluid bg-primary py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row justify-content-start">
            <div class="col-lg-8 text-center text-lg-start">
                <h1 class="display-1 text-uppercase text-white mb-4">Sobre Nosotros</h1>
                <h1 class="text-uppercase text-white">Nuestra historia y pasión</h1>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->
<!-- About Start -->
<div class="container-fluid pt-5">
    <div class="container">
        <div class="section-title position-relative text-center mx-auto mb-5 pb-3" style="max-width: 600px;">
            <h2 class="text-primary font-secondary">Nuestra Historia</h2>
            <h1 class="display-4 text-uppercase">Bienvenido a RF Bakery</h1>
        </div>
        <div class="row gx-5">
            <div class="col-lg-5 mb-5 mb-lg-0" style="min-height: 400px;">
                <div class="position-relative h-100">
                    <img class="position-absolute w-100 h-100" src="~/images/about.jpg" style="object-fit: cover;">
                </div>
            </div>
            <div class="col-lg-6 pb-5">
                <h4 class="mb-4">Más de 15 años endulzando momentos especiales</h4>
                <p class="mb-5">
                    RF Bakery nació del amor por la repostería artesanal y el deseo de compartir con nuestra comunidad
                    los sabores auténticos que solo se logran con dedicación y los mejores ingredientes.
                    Cada torta, cada postre, es preparado con el mismo cariño con el que lo haríamos para nuestra propia familia.
                </p>
                <p class="mb-5">
                    A lo largo de los años hemos crecido gracias a la confianza de nuestros clientes, quienes celebran
                    sus cumpleaños, bodas y momentos más importantes junto a nuestras creaciones.
                </p>
                <div class="row g-5">
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center justify-content-center bg-primary border-inner mb-4" style="width: 90px; height: 90px;">
                            <i class="fa fa-heartbeat fa-2x text-white"></i>
                        </div>
                        <h4 class="text-uppercase">100% Artesanal</h4>
                        <p class="mb-0">Cada producto es elaborado a mano, con ingredientes frescos y de calidad.</p>
                    </div>
                    <div class="col-sm-6">
                        <div class="d-flex align-items-center justify-content-center bg-primary border-inner mb-4" style="width: 90px; height: 90px;">
                            <i class="fa fa-award fa-2x text-white"></i>
                        </div>
                        <h4 class="text-uppercase">Calidad Premiada</h4>
                        <p class="mb-0">Reconocidos por nuestros clientes como una de las mejores pastelerías de la zona.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- About End -->