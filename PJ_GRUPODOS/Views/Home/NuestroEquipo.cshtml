@{
    Layout = "_LayoutExterno";
}

<!-- Hero Start -->
<div class="container-fluid bg-primary py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row justify-content-start">
            <div class="col-lg-8 text-center text-lg-start">
                <h1 class="display-1 text-uppercase text-white mb-4">Nuestro Equipo</h1>
                <h1 class="text-uppercase text-white">Las manos detrás de cada creación</h1>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->
<!-- Team Start -->
<div class="container-fluid py-5">
    <div class="container">
        <div class="section-title position-relative text-center mx-auto mb-5 pb-3" style="max-width: 600px;">
            <h2 class="text-primary font-secondary">Conócenos</h2>
            <h1 class="display-4 text-uppercase">Nuestro Equipo</h1>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="text-center bg-secondary border-inner p-4 h-100">
                    <div class="d-flex align-items-center justify-content-center bg-primary rounded-circle mx-auto mb-4" style="width: 120px; height: 120px;">
                        <i class="bi bi-person-fill fs-1 text-white"></i>
                    </div>
                    <h4 class="text-uppercase">Chef Principal</h4>
                    <p class="text-primary mb-3">Repostería y Diseño</p>
                    <p class="mb-0">Encargado de crear cada receta y supervisar la calidad de nuestros productos.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="text-center bg-secondary border-inner p-4 h-100">
                    <div class="d-flex align-items-center justify-content-center bg-primary rounded-circle mx-auto mb-4" style="width: 120px; height: 120px;">
                        <i class="bi bi-person-fill fs-1 text-white"></i>
                    </div>
                    <h4 class="text-uppercase">Pastelero</h4>
                    <p class="text-primary mb-3">Producción</p>
                    <p class="mb-0">Encargado de la elaboración diaria de nuestras tortas y postres artesanales.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="text-center bg-secondary border-inner p-4 h-100">
                    <div class="d-flex align-items-center justify-content-center bg-primary rounded-circle mx-auto mb-4" style="width: 120px; height: 120px;">
                        <i class="bi bi-person-fill fs-1 text-white"></i>
                    </div>
                    <h4 class="text-uppercase">Atención al Cliente</h4>
                    <p class="text-primary mb-3">Pedidos y Servicio</p>
                    <p class="mb-0">Encargado de atender tus pedidos y asegurar la mejor experiencia de compra.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Team End -->