@{
    Layout = "_Layout";
}
<!-- Hero Start -->
<div class="container-fluid bg-primary py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row justify-content-start">
            <div class="col-lg-8 text-center text-lg-start">
                <h1 class="display-1 text-uppercase text-white mb-4">Nuestro Servicio</h1>
                <h1 class="text-uppercase text-white">Lo que hacemos por ti</h1>
            </div>
        </div>
    </div>
</div>
<!-- Hero End -->
<!-- Service Start -->
<div class="container-fluid py-5">
    <div class="container">
        <div class="section-title position-relative text-center mx-auto mb-5 pb-3" style="max-width: 600px;">
            <h2 class="text-primary font-secondary">Servicios</h2>
            <h1 class="display-4 text-uppercase">Lo Que Ofrecemos</h1>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="text-center bg-secondary border-inner p-4 h-100">
                    <div class="d-flex align-items-center justify-content-center bg-primary border-inner mx-auto mb-4" style="width: 90px; height: 90px;">
                        <i class="bi bi-cake2-fill fs-2 text-white"></i>
                    </div>
                    <h4 class="text-uppercase">Tortas Personalizadas</h4>
                    <p class="mb-0">Diseñamos tu torta a tu gusto, con los sabores y decoración que prefieras para tu ocasión especial.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="text-center bg-secondary border-inner p-4 h-100">
                    <div class="d-flex align-items-center justify-content-center bg-primary border-inner mx-auto mb-4" style="width: 90px; height: 90px;">
                        <i class="bi bi-truck fs-2 text-white"></i>
                    </div>
                    <h4 class="text-uppercase">Entrega a Domicilio</h4>
                    <p class="mb-0">Llevamos tu pedido directo a tu puerta, fresco y a tiempo para tu celebración.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="text-center bg-secondary border-inner p-4 h-100">
                    <div class="d-flex align-items-center justify-content-center bg-primary border-inner mx-auto mb-4" style="width: 90px; height: 90px;">
                        <i class="bi bi-calendar-event fs-2 text-white"></i>
                    </div>
                    <h4 class="text-uppercase">Eventos Especiales</h4>
                    <p class="mb-0">Nos encargamos de la repostería para bodas, quinceañeros y todo tipo de celebraciones.</p>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Service End -->