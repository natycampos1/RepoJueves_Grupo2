@model UsuarioModel
@{
    Layout = "_LayoutExterno";
}

<!-- Register Section Start -->
<div class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-11 col-lg-12">
                <div class="auth-card">
                    <div class="row g-0">
                        <!-- Image Side -->
                        <div class="col-lg-4 d-none d-lg-flex">
                            <div class="auth-image-side w-100">
                                <i class="fa fa-birthday-cake auth-cake-icon"></i>
                                <h3 class="font-secondary text-primary mb-4">¿Por qué unirte?</h3>

                                <div class="benefit-item">
                                    <div class="benefit-icon">
                                        <i class="bi bi-tag-fill text-white"></i>
                                    </div>
                                    <div>
                                        <p class="text-white mb-0" style="font-size:14px;font-weight:600;">Descuentos Exclusivos</p>
                                        <p class="text-secondary mb-0" style="font-size:12px;">Accede a ofertas solo para miembros</p>
                                    </div>
                                </div>

                                <div class="benefit-item">
                                    <div class="benefit-icon">
                                        <i class="bi bi-truck text-white"></i>
                                    </div>
                                    <div>
                                        <p class="text-white mb-0" style="font-size:14px;font-weight:600;">Pedidos en Línea</p>
                                        <p class="text-secondary mb-0" style="font-size:12px;">Ordena y rastrea tus pedidos fácilmente</p>
                                    </div>
                                </div>

                                <div class="benefit-item">
                                    <div class="benefit-icon">
                                        <i class="bi bi-heart-fill text-white"></i>
                                    </div>
                                    <div>
                                        <p class="text-white mb-0" style="font-size:14px;font-weight:600;">Lista de Favoritos</p>
                                        <p class="text-secondary mb-0" style="font-size:12px;">Guarda tus pasteles preferidos</p>
                                    </div>
                                </div>

                                <div class="benefit-item">
                                    <div class="benefit-icon">
                                        <i class="bi bi-gift-fill text-white"></i>
                                    </div>
                                    <div>
                                        <p class="text-white mb-0" style="font-size:14px;font-weight:600;">Programa de Puntos</p>
                                        <p class="text-secondary mb-0" style="font-size:12px;">Acumula y canjea puntos en cada compra</p>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <p class="text-secondary mb-2" style="font-size:13px;">¿Ya tienes cuenta?</p>
                                    <a href="login.html" class="btn btn-primary border-inner px-4 py-2" style="font-family:'Oswald',sans-serif;font-weight:600;letter-spacing:1px;">
                                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Form Side -->
                        <div class="col-lg-8">
                            <div class="auth-card-header">
                                <i class="bi bi-person-plus-fill text-primary fs-1 mb-2"></i>
                                <h3 class="text-white text-uppercase mb-1" style="font-family:'Oswald',sans-serif;letter-spacing:2px;">Crear Nueva Cuenta</h3>
                                <p class="text-secondary mb-0" style="font-size:14px;">Completa el formulario para unirte a la familia CakeZone</p>
                            </div>
                            <div class="auth-card-body">

                                <!-- Success message (hidden by default) -->
                                <div id="registerSuccess" class="alert alert-success d-none" role="alert">
                                    <i class="bi bi-check-circle me-2"></i>
                                    <strong>¡Cuenta creada con éxito!</strong> Revisa tu correo para verificar tu cuenta.
                                </div>

                                <!-- Register Form -->
                                <form id="registerForm" novalidate>
                                    <div class="row g-4">
                                        <!-- Nombre -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="firstName">Nombre</label>
                                            <div class="input-wrapper">
                                                <input type="text" class="form-control form-control-auth" id="firstName"
                                                       placeholder="Tu nombre" required minlength="2">
                                            </div>
                                            <div class="invalid-feedback">Por favor ingresa tu nombre (mín. 2 caracteres).</div>
                                        </div>

                                        <!-- 1 Apellido -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="lastName">Primer Apellido</label>
                                            <div class="input-wrapper">
                                                <input type="text" class="form-control form-control-auth" id="lastName"
                                                       placeholder="Tu apellido" required minlength="2">
                                            </div>
                                            <div class="invalid-feedback">Por favor ingresa tu apellido (mín. 2 caracteres).</div>
                                        </div>

                                        <!-- 2 Apellido -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="lastName">Segundo Apellido</label>
                                            <div class="input-wrapper">
                                                <input type="text" class="form-control form-control-auth" id="lastName"
                                                       placeholder="Tu apellido" required minlength="2">
                                            </div>
                                            <div class="invalid-feedback">Por favor ingresa tu apellido (mín. 2 caracteres).</div>
                                        </div>

                                        <!-- Identificacion -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="lastName">Identificación</label>
                                            <div class="input-wrapper">
                                                <input type="text" class="form-control form-control-auth" id="lastName"
                                                       placeholder="Tu identificación" required minlength="5">
                                            </div>
                                            <div class="invalid-feedback">Por favor ingresa tu identificación.</div>
                                        </div>

                                        <!-- Genero -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="lastName">Genero</label>
                                            <div class="input-wrapper">
                                                <input type="text" class="form-control form-control-auth" id="lastName"
                                                       placeholder="Tu genero" required minlength="2">
                                            </div>
                                            <div class="invalid-feedback">Por favor ingresa tu genero (mín. 2 caracteres).</div>
                                        </div>

                                        <!-- Correo -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="regEmail">Correo Electrónico</label>
                                            <div class="input-wrapper">
                                                <input type="email" class="form-control form-control-auth" id="regEmail"
                                                       placeholder="tucorreo@ejemplo.com" required>
                                            </div>
                                            <div class="invalid-feedback">Por favor ingresa un correo válido.</div>
                                        </div>

                                        <!-- Teléfono -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="phone">Teléfono <span class="text-muted" style="font-size:11px;font-weight:400;">(Opcional)</span></label>
                                            <div class="input-wrapper">
                                                <input type="tel" class="form-control form-control-auth" id="phone"
                                                       placeholder="+506 8888-8888">
                                            </div>
                                        </div>

                                        <!-- Dirección -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="lastName">Dirección</label>
                                            <div class="input-wrapper">
                                                <input type="text" class="form-control form-control-auth" id="lastName"
                                                       placeholder="Tu dirección" required minlength="5">
                                            </div>
                                            <div class="invalid-feedback">Por favor ingresa tu Dirección.</div>
                                        </div>

                                        <!-- Contraseña -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="regPassword">Contraseña</label>
                                            <div class="input-wrapper">
                                                <input type="password" class="form-control form-control-auth" id="regPassword"
                                                       placeholder="Mínimo 8 caracteres" required minlength="8">
                                                <i class="bi bi-eye input-icon" id="toggleRegPassword"></i>
                                            </div>
                                            <div class="strength-bar">
                                                <div class="strength-fill" id="strengthFill"></div>
                                            </div>
                                            <div class="strength-text" id="strengthText" style="color:#aaa;">Ingresa una contraseña</div>
                                            <div class="invalid-feedback">La contraseña debe tener al menos 8 caracteres.</div>
                                        </div>

                                        <!-- Confirmar Contraseña -->
                                        <div class="col-md-6">
                                            <label class="label-auth" for="confirmPassword">Confirmar Contraseña</label>
                                            <div class="input-wrapper">
                                                <input type="password" class="form-control form-control-auth" id="confirmPassword"
                                                       placeholder="Repite tu contraseña" required>
                                                <i class="bi bi-eye input-icon" id="toggleConfirmPassword"></i>
                                            </div>
                                            <div class="invalid-feedback" id="confirmError">Las contraseñas no coinciden.</div>
                                        </div>

                                        <!-- Submit -->
                                        <div class="col-12">
                                            <button type="submit" class="btn btn-auth btn-auth-primary" id="registerBtn">
                                                <i class="bi bi-person-check me-2"></i>Crear Mi Cuenta
                                            </button>
                                        </div>

                                        <div class="col-12 text-center d-lg-none">
                                            <p class="mb-0" style="font-size:14px;color:#888;">
                                                ¿Ya tienes cuenta?
                                                <a asp-action="IniciarSesion" asp-controller="Home" class="auth-link">Inicia sesión aquí</a>
                                            </p>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Register Section End -->