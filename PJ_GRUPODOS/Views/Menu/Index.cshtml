@{
    Layout = "_Layout";
    var categorias = ViewBag.Categorias as List<PJ_GRUPODOS.Models.CategoriaProductoModel>;
    var productosPorCategoria = ViewBag.ProductosPorCategoria as Dictionary<int, List<PJ_GRUPODOS.Models.ProductoCatalogoModel>>;
    bool autenticado = Context.Session.GetInt32("Autenticado") == 1;
    var idRol = Context.Session.GetInt32("IdRol") ?? 0;
    bool esAdministrador = idRol == 1;
    bool esCliente = idRol == 2;
}

@if (TempData["MensajeCarrito"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-success alert-dismissible show fade">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["MensajeCarrito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    </div>
}

<!-- Menu Hero Start -->
<div class="container-fluid bg-primary py-5 mb-5 hero-header">
    <div class="container py-5">
        <div class="row justify-content-between align-items-center">
            <div class="col-lg-8 text-center text-lg-start">
                <h1 class="display-1 text-uppercase text-white mb-4">Nuestro Menú</h1>
                <h1 class="text-uppercase text-white">Sabores que enamoran</h1>
            </div>
            <div class="col-lg-3 text-center">
                <a asp-action="Index" asp-controller="Carrito" class="btn btn-dark border-inner px-4 py-3">
                    <i class="bi bi-cart-fill me-2"></i>Ver Carrito
                </a>
            </div>
        </div>
    </div>
</div>
<!-- Menu Hero End -->
<!-- Products Start -->
<div class="container-fluid about py-5">
    <div class="container">
        <div class="section-title position-relative text-center mx-auto mb-5 pb-3" style="max-width: 600px;">
            <h2 class="text-primary font-secondary">Menú y Precios</h2>
            <h1 class="display-4 text-uppercase">Explora Nuestras Tortas</h1>
        </div>

        @if (categorias != null && categorias.Any())
        {
            <div class="tab-class text-center">
                <ul class="nav nav-pills d-inline-flex justify-content-center bg-dark text-uppercase border-inner p-4 mb-5">
                    @for (int i = 0; i < categorias.Count; i++)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white @(i == 0 ? "active" : "")" data-bs-toggle="pill" href="#tab-@categorias[i].IdCategoria">@categorias[i].Descripcion</a>
                        </li>
                    }
                </ul>
                <div class="tab-content">
                    @for (int i = 0; i < categorias.Count; i++)
                    {
                        var categoria = categorias[i];
                        var productos = productosPorCategoria != null && productosPorCategoria.ContainsKey(categoria.IdCategoria)
                            ? productosPorCategoria[categoria.IdCategoria]
                            : new List<PJ_GRUPODOS.Models.ProductoCatalogoModel>();

                        <div id="tab-@categoria.IdCategoria" class="tab-pane fade show p-0 @(i == 0 ? "active" : "")">
                            <div class="row g-3">
                                @if (productos.Any())
                                {
                                    @foreach (var producto in productos)
                                    {
                                        bool sinStock = producto.StockDisponible <= 0;

                                        <div class="col-lg-6">
                                            <div class="d-flex h-100">
                                                <div class="flex-shrink-0">
                                                    <img class="img-fluid" src="~/images/@producto.Imagen" alt="@producto.Nombre" style="width: 150px; height: 85px;">
                                                    <h4 class="bg-dark text-primary p-2 m-0">₡@producto.Precio.ToString("N0")</h4>
                                                </div>
                                                <div class="d-flex flex-column justify-content-center text-start bg-secondary border-inner px-4 flex-grow-1">
                                                    <h5 class="text-uppercase">@producto.Nombre</h5>
                                                    <span>@producto.Descripcion</span>

                                                    @if (producto.PedidoAnticipado)
                                                    {
                                                        <small class="text-info fw-bold mt-1">
                                                            <i class="bi bi-clock-fill me-1"></i>Requiere pedido con anticipación
                                                        </small>
                                                    }

                                                    @if (sinStock)
                                                    {
                                                        <small class="text-danger fw-bold mt-1">
                                                            <i class="bi bi-x-circle-fill me-1"></i>Agotado
                                                        </small>
                                                    }
                                                    else if (producto.StockDisponible <= 5)
                                                    {
                                                        <small class="text-warning fw-bold mt-1">
                                                            <i class="bi bi-exclamation-triangle-fill me-1"></i>¡Solo quedan @producto.StockDisponible disponibles!
                                                        </small>
                                                    }
                                                    else
                                                    {
                                                        <small class="text-success mt-1">
                                                            <i class="bi bi-check-circle-fill me-1"></i>@producto.StockDisponible disponibles
                                                        </small>
                                                    }

                                                    @if (!autenticado)
                                                    {

                                                        <div class="mt-2">
                                                            <input type="hidden" name="idProducto" value="@producto.IdProducto" />
                                                            <input type="hidden" name="nombreProducto" value="@producto.Nombre" />
                                                            <input type="hidden" name="precio" value="@producto.Precio" />
                                                            <input type="hidden" name="imagen" value="@producto.Imagen" />
                                                            <button type="button" class="btn btn-sm btn-primary" @(sinStock ? "disabled" : "") data-bs-toggle="modal"
                                                                    data-bs-target="#loginRequiredModal">
                                                                <i class="bi bi-cart-plus me-1"></i>Agregar al Carrito
                                                            </button>
                                                        </div>

                                                    }
                                                    else if (esCliente)
                                                    {

                                                        <form asp-action="Agregar" asp-controller="Carrito" method="post" class="mt-2">
                                                            <input type="hidden" name="idProducto" value="@producto.IdProducto" />
                                                            <input type="hidden" name="idCatalogoSemanal" value="@producto.IdCatalogoSemanal" />
                                                            <input type="hidden" name="nombreProducto" value="@producto.Nombre" />
                                                            <input type="hidden" name="precio" value="@producto.Precio" />
                                                            <input type="hidden" name="imagen" value="@producto.Imagen" />
                                                            <input type="hidden" name="limitePorPersona" value="@producto.LimitePorPersona" />
                                                             <input type="hidden" name="pedidoAnticipado" value="@producto.PedidoAnticipado" /> <input type="hidden" name="puntosEsfuerzo" value="@producto.PuntosEsfuerzo" />
                                                            <button type="submit" class="btn btn-sm btn-primary" @(sinStock ? "disabled" : "")>
                                                                <i class="bi bi-cart-plus me-1"></i>Agregar al Carrito
                                                            </button>
                                                        </form>
                                                    }

                                                    

                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center">
                                        <p>No hay productos disponibles en esta categoría por el momento.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="text-center">
                <p>No se pudo cargar el menú en este momento. Intenta más tarde.</p>
            </div>
        }
    </div>
</div>
<!-- Products End -->
<!-- Modal: Inicio de Sesión Requerido -->
<div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-labelledby="loginRequiredModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">

            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold" id="loginRequiredModalLabel">
                    <i class="bi bi-lock-fill text-warning me-2"></i>
                    Acceso requerido
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <p class="mb-2">
                    Debe iniciar sesión para poder realizar pedidos.
                </p>

                <p class="text-muted mb-0">
                    Si aún no posee una cuenta, puede registrarse gratuitamente.
                </p>

            </div>

            <div class="modal-footer border-0">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <a asp-controller="Home"
                   asp-action="RegistrarUsuario"
                   class="btn btn-outline-primary">
                    Registrarse
                </a>

                <a asp-controller="Home"
                   asp-action="IniciarSesion"
                   class="btn btn-primary">
                    Iniciar Sesión
                </a>

            </div>

        </div>
    </div>
</div>