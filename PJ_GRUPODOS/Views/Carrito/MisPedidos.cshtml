@model List<PJ_GRUPODOS.Models.PedidoModel>
@{
    Layout = "_Layout";
}

<div class="container py-5">

    <h2 class="text-uppercase mb-4">Mis Pedidos</h2>

    @if (TempData["MensajePedido"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["MensajePedido"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card p-4">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Pedido #</th>
                        <th>Fecha</th>
                        <th>Tipo de Entrega</th>
                        <th>Estado</th>
                        <th>Total</th>
                        <th class="text-center">Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pedido in Model)
                    {
                        <tr>
                            <td>#@pedido.IdPedido</td>
                            <td>@pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@pedido.TipoEntrega</td>
                            <td>
                                <span class="badge bg-secondary">@pedido.EstadoPedido</span>
                            </td>
                            <td>₡@pedido.Total.ToString("N0")</td>
                            <td class="text-center">
                                <a asp-action="DetallePedido" asp-controller="Carrito" asp-route-idPedido="@pedido.IdPedido" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card p-5 text-center">
            <p class="text-muted mb-3">Todavía no has realizado ningún pedido</p>
            <a asp-action="Index" asp-controller="Menu" class="btn btn-primary mx-auto" style="width: fit-content;">
                Ver Menú
            </a>
        </div>
    }
</div>