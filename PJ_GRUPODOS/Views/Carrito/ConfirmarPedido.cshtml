@{
    Layout = "_Layout";
    var carrito = ViewBag.Carrito as List<PJ_GRUPODOS.Models.ItemCarritoModel>;
    var tiposEntrega = ViewBag.TiposEntrega as List<PJ_GRUPODOS.Models.TipoEntregaModel>;
    decimal total = ViewBag.Total;
}

<div class="container py-5">

    <h2 class="text-uppercase mb-4">Confirmar Pedido</h2>

    @if (ViewBag.MensajeError != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @ViewBag.MensajeError
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-7">
            <div class="card p-4">
                <h5 class="mb-3">Resumen del Pedido</h5>
                <table class="table">
                    <tbody>
                        @if (carrito != null)
                        {
                            @foreach (var item in carrito)
                            {
                                <tr>
                                    <td>@item.NombreProducto</td>
                                    <td>x @item.Cantidad</td>
                                    <td class="text-end">₡@((item.Precio * item.Cantidad).ToString("N0"))</td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2"><strong>Total</strong></td>
                            <td class="text-end"><strong>₡@total.ToString("N0")</strong></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card p-4">
                <h5 class="mb-3">Datos de Entrega</h5>
                <form asp-action="ConfirmarPedido" asp-controller="Carrito" method="post" id="ConfirmarPedidoForm">

                    <div class="mb-3">
                        <label class="form-label">Tipo de Entrega</label>
                        <select name="IdTipoEntrega" class="form-select" required id="tipoEntregaSelect">
                            <option value="">-- Seleccione --</option>
                            @if (tiposEntrega != null)
                            {
                                @foreach (var tipo in tiposEntrega)
                                {
                                    <option value="@tipo.IdTipoEntrega" data-descripcion="@tipo.Descripcion">@tipo.Descripcion</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3 d-none" id="direccionGroup">
                        <label class="form-label">Dirección de Entrega</label>
                        <textarea name="DireccionEntrega" id="direccionEntrega" class="form-control" rows="3" placeholder="Escribe tu dirección completa"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-check-circle me-2"></i>Confirmar Pedido
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

<script src="~/js/confirmarpedido.js" asp-append-version="true"></script>