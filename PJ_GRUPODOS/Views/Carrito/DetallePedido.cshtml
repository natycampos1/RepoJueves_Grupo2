@model List<PJ_GRUPODOS.Models.DetallePedidoModel>
@{
    Layout = "_Layout";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase">Detalle del Pedido</h2>
        <a asp-action="MisPedidos" asp-controller="Carrito" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="card p-4">
        <table class="table">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.NombreProducto</td>
                            <td>@item.Cantidad</td>
                            <td>₡@item.PrecioUnitario.ToString("N0")</td>
                            <td>₡@item.Subtotal.ToString("N0")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>