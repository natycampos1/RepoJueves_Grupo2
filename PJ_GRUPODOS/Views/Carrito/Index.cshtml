@model List<PJ_GRUPODOS.Models.ItemCarritoModel>
@{
    Layout = "_Layout";
    decimal total = ViewBag.Total;
    var stockDisponible = ViewBag.StockDisponible as Dictionary<int, int>;
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase">Tu Carrito</h2>
        <a asp-action="Index" asp-controller="Menu" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-2"></i>Seguir Comprando
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        bool haySuperaStock = false;

        <div class="card p-4">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th></th>
                        <th>Producto</th>
                        <th>Precio Unitario</th>
                        <th style="width: 140px;">Cantidad</th>
                        <th>Subtotal</th>
                        <th class="text-center">Quitar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        int stock = stockDisponible != null && stockDisponible.ContainsKey(item.IdProducto)
                            ? stockDisponible[item.IdProducto]
                            : 0;
                        bool superaStock = item.Cantidad > stock;

                        if (superaStock)
                        {
                            haySuperaStock = true;
                        }

                        <tr class="@(superaStock ? "table-warning" : "")">
                            <td>
                                @if (!string.IsNullOrEmpty(item.Imagen))
                                {
                                    <img src="~/images/@item.Imagen" alt="@item.NombreProducto" style="width: 60px; height: 60px; object-fit: cover;" />
                                }
                            </td>
                            <td>
                                @item.NombreProducto
                                @if (superaStock)
                                {
                                    <br />
                                    <small class="text-danger">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Solo quedan @stock disponibles
                                    </small>
                                }
                            </td>
                            <td>₡@item.Precio.ToString("N0")</td>
                            <td>
                                <form asp-action="ActualizarCantidad" asp-controller="Carrito" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="idProducto" value="@item.IdProducto" />
                                    <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="@Math.Min(stock, item.LimitePorPersona)" class="form-control form-control-sm" style="width: 70px;" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                </form>
                                <small class="text-muted">Máx. @item.LimitePorPersona por persona</small>
                            </td>
                            <td>₡@((item.Precio * item.Cantidad).ToString("N0"))</td>
                            <td class="text-center">
                                <form asp-action="Eliminar" asp-controller="Carrito" method="post">
                                    <input type="hidden" name="idProducto" value="@item.IdProducto" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="4" class="text-end"><strong>Total:</strong></td>
                        <td colspan="2"><strong>₡@total.ToString("N0")</strong></td>
                    </tr>
                </tfoot>
            </table>

            @if (haySuperaStock)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Algunos productos superan el stock disponible. Ajusta las cantidades antes de continuar.
                </div>
            }

            <div class="text-end mt-3">
                <a asp-action="ConfirmarPedido" asp-controller="Carrito" class="btn btn-primary btn-lg @(haySuperaStock ? "disabled" : "")">
                    <i class="bi bi-check-circle me-2"></i>Confirmar Pedido
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card p-5 text-center">
            <i class="bi bi-cart-x fs-1 text-muted mb-3"></i>
            <p class="text-muted mb-3">Tu carrito está vacío</p>
            <a asp-action="Index" asp-controller="Menu" class="btn btn-primary mx-auto" style="width: fit-content;">
                Ver Menú
            </a>
        </div>
    }
</div>