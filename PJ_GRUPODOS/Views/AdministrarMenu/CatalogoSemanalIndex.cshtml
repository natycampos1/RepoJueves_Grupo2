@{
    Layout = "_Layout";
    var productos = ViewBag.Productos as List<PJ_GRUPODOS.Models.ProductoAdminModel>;
    var fechaInicioSemana = (DateTime)ViewBag.FechaInicioSemana;
    var catalogoSemanal = Model as List<PJ_GRUPODOS.Models.CatalogoSemanalAdminModel>;
    var tipoMensaje = TempData["TipoMensajeCatalogoSemanal"] as string ?? "info";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-uppercase">Catálogo Semanal</h2>
        <span class="text-muted">Semana del @fechaInicioSemana.ToString("dd/MM/yyyy")</span>
    </div>

    @if (TempData["MensajeCatalogoSemanal"] != null)
    {
        <div class="alert alert-@tipoMensaje alert-dismissible show fade">
            <i class="bi @(tipoMensaje == "success" ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
            @TempData["MensajeCatalogoSemanal"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        
        <div class="col-lg-4">
            <div class="card p-4">
                <h5 class="mb-3">Agregar Producto a la Semana</h5>
                <form asp-action="AgregarCatalogoSemanal" asp-controller="AdministrarMenu" method="post">

                    <div class="mb-3">
                        <label class="form-label">Producto</label>
                        <select name="idProducto" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                            @if (productos != null)
                            {
                                @foreach (var producto in productos)
                                {
                                    <option value="@producto.IdProducto">@producto.Nombre (@producto.Categoria)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Stock Disponible</label>
                        <input type="number" name="stockDisponible" class="form-control" placeholder="10" min="0" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Límite por Persona</label>
                        <input type="number" name="limitePorPersona" class="form-control" placeholder="3" min="1" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-2"></i>Agregar a la Semana
                    </button>
                </form>
            </div>
        </div>

    
        <div class="col-lg-8">
            <div class="card p-4">
                <h5 class="mb-3">Configurado para esta Semana</h5>
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Categoría</th>
                            <th>Producto</th>
                            <th>Stock</th>
                            <th>Límite</th>
                            <th>Visible</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (catalogoSemanal != null && catalogoSemanal.Any())
                        {
                            @foreach (var item in catalogoSemanal)
                            {
                                var formId = "form-catalogo-" + item.IdCatalogoSemanal;

                                <!-- formulario vacio, separado de la fila, para no romper la estructura de la tabla -->
                                <form id="@formId" asp-action="ActualizarCatalogoSemanal" asp-controller="AdministrarMenu" method="post">
                                    <input type="hidden" name="idCatalogoSemanal" value="@item.IdCatalogoSemanal" />
                                </form>

                                <tr>
                                    <td>@item.Categoria</td>
                                    <td>@item.Nombre</td>
                                    <td>
                                        <input type="number" name="stockDisponible" form="@formId" value="@item.StockDisponible" class="form-control form-control-sm" style="width:80px;" min="0" required />
                                    </td>
                                    <td>
                                        <input type="number" name="limitePorPersona" form="@formId" value="@item.LimitePorPersona" class="form-control form-control-sm" style="width:70px;" min="1" required />
                                    </td>
                                    <td>
                                        <select name="activo" form="@formId" class="form-select form-select-sm" style="width:100px;">
                                            <option value="true" selected="@(item.Activo)">Sí</option>
                                            <option value="false" selected="@(!item.Activo)">No</option>
                                        </select>
                                    </td>
                                    <td class="text-center">
                                        <button type="submit" form="@formId" class="btn btn-sm btn-primary">
                                            <i class="bi bi-check-circle me-1"></i>Guardar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center">No hay productos configurados para esta semana.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>