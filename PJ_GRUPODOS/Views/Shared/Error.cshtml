@{
    ViewData["Title"] = "Error";
}
@{
    var autenticado = Context.Session.GetInt32("Autenticado");
    if (autenticado == 1)
    {
        Layout = "_Layout";
    }
    else
    {
        Layout = "_LayoutExterno";
    }
}

<div id="errorMessagePage" class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow border-0 text-center p-4">
                <div class="card-body">

                    <h1 class="text-danger display-4 mb-3">
                        ¡Ups!
                    </h1>

                    <h2 class="h4 mb-3">
                        Ha ocurrido un error al procesar la solicitud.
                    </h2>

                    <p class="text-muted mb-4">
                        Lo sentimos, en este momento no pudimos completar la operación.
                        Por favor, inténtelo nuevamente más tarde.
                    </p>

                    <hr />

                    <h3 class="h5 mt-4 mb-3">
                        ¿Necesita ayuda?
                    </h3>

                    <p class="mb-2">
                        Puede comunicarse con la administración de <strong>RF Bakery</strong>.
                    </p>

                    <p class="mb-0">
                        <strong>Teléfono:</strong> +012 345 67890 <br />
                        <strong>Correo:</strong> rebakery@example.com
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>

