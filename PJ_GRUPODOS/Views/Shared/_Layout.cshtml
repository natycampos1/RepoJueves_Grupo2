<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <title>RF Bakery</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Free HTML Templates" name="keywords">
    <meta content="Free HTML Templates" name="description">

    <!-- Favicon -->
    <link href="~/img/favicon.ico" rel="icon" asp-append-version="true">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Oswald:wght@500;600;700&family=Pacifico&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet" asp-append-version="true">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">

    <!-- Template Stylesheet -->
    <link href="~/css/style.css" rel="stylesheet" asp-append-version="true">

    <!-- Para renderizar algun otro css especifico de las vistas hijas -->
    @await RenderSectionAsync("Styles", required: false)

    <!-- jQuery Validation Plugin -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.21.0/dist/jquery.validate.min.js"></script>
</head>

<body>
    @{
        bool autenticado = Context.Session.GetInt32("Autenticado") == 1;
        var nombre = Context.Session.GetString("Nombre") ?? "Usuario";
        var primerApellido = Context.Session.GetString("PrimerApellido") ?? "";
        var segundoApellido = Context.Session.GetString("SegundoApellido") ?? "";
        var identificacion = Context.Session.GetString("Identificacion") ?? "...";
        var email = Context.Session.GetString("Email") ?? "...";
        var idRol = Context.Session.GetInt32("IdRol") ?? 0;
        bool esAdministrador = idRol == 1;
        bool esCliente = idRol == 2;

    }

    <!-- Topbar Start -->
    <div class="container-fluid px-0 d-none d-lg-block">
        <div class="row gx-0">
            <div class="col-lg-4 text-center bg-secondary py-3">
                <div class="d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-envelope fs-1 text-primary me-3"></i>
                    <div class="text-start">
                        <h6 class="text-uppercase mb-1">Escribenos</h6>
                        <span>rebakery@example.com</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-center bg-primary border-inner py-3">
                <div class="d-inline-flex align-items-center justify-content-center">
                    <a asp-action="Index" asp-controller="Home" class="navbar-brand">
                        <h1 class="m-0 text-uppercase text-white"><i class="fa fa-birthday-cake fs-1 text-dark me-3"></i>RF Bakery</h1>
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center bg-secondary py-3">
                <div class="d-inline-flex align-items-center justify-content-center">
                    <i class="bi bi-phone-vibrate fs-1 text-primary me-3"></i>
                    <div class="text-start">
                        <h6 class="text-uppercase mb-1">Llamanos</h6>
                        <span>+012 345 6789</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Topbar End -->
    <!-- Navbar Start -->
    <nav class="navbar navbar-expand-lg bg-dark navbar-dark shadow-sm py-3 py-lg-0 px-3 px-lg-0">
        <a href="index.html" class="navbar-brand d-block d-lg-none">
            <h1 class="m-0 text-uppercase text-white"><i class="fa fa-birthday-cake fs-1 text-primary me-3"></i>RF Bakery</h1>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto mx-lg-auto py-0">
                <div class="navbar-nav ms-auto mx-lg-auto py-0">
                    @if (!autenticado)
                    {
                        <div class="navbar-nav ms-auto mx-lg-auto py-0">
                            <a asp-action="Index" asp-controller="Home" class="nav-item nav-link active">Inicio</a>
                            <a asp-action="SobreNosotros" asp-controller="Home" class="nav-item nav-link">Sobre Nosotros</a>
                            <a asp-action="Index" asp-controller="Menu" class="nav-item nav-link">Menú y Precios</a>
                            <a asp-action="NuestroEquipo" asp-controller="Home" class="nav-item nav-link">Nuestro Equipo</a>
                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Mas Detalles</a>
                                <div class="dropdown-menu m-0">
                                    <a asp-action="NuestroServicio" asp-controller="Home" class="dropdown-item">Nuestro Servicio</a>
                                    <a asp-action="Testimonios" asp-controller="Home" class="dropdown-item">Testimonios</a>
                                </div>
                            </div>
                            <a asp-action="Index" asp-controller="Contacto" class="nav-item nav-link">Contáctanos</a>
                        </div>

                    }

                    @if (esCliente)
                    {
                        <div class="navbar-nav ms-auto mx-lg-auto py-0">
                            <a asp-action="Index" asp-controller="Home" class="nav-item nav-link active">Inicio</a>
                            <a asp-action="SobreNosotros" asp-controller="Home" class="nav-item nav-link">Sobre Nosotros</a>
                            <a asp-action="Index" asp-controller="Menu" class="nav-item nav-link">Menú y Precios</a>
                            <a asp-action="NuestroEquipo" asp-controller="Home" class="nav-item nav-link">Nuestro Equipo</a>
                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Mas Detalles</a>
                                <div class="dropdown-menu m-0">
                                    <a asp-action="NuestroServicio" asp-controller="Home" class="dropdown-item">Nuestro Servicio</a>
                                    <a asp-action="Testimonios" asp-controller="Home" class="dropdown-item">Testimonios</a>
                                </div>
                            </div>
                            <a asp-action="Index" asp-controller="Contacto" class="nav-item nav-link">Contáctanos</a>
                            <a asp-action="MisPedidos" asp-controller="Carrito" class="nav-item nav-link">
                                Mis Pedidos
                            </a>
                        </div>
                    }

                    @if (esAdministrador)
                    {
                        <div class="navbar-nav ms-auto mx-lg-auto py-0">
                            <a class="nav-item nav-link" asp-action="Index" asp-controller="AdministrarMenu">
                                <i class="bi bi-gear-fill me-2"></i>
                                Administrar Menú
                            </a>

                            <a class="nav-item nav-link" asp-action="PedidosIndex" asp-controller="AdministrarMenu">
                                <i class="bi bi-receipt me-2"></i>
                                Administrar Pedidos
                            </a>
                        </div>
                    }
                </div>
            </div>

            @if (autenticado)
            {
                <!-- Opciones de usuario -->
                <div class="dropdown ms-4 py-3 py-lg-0 me-5">

                    <a href="#"
                       class="d-flex align-items-center text-decoration-none dropdown-toggle"
                       id="dropdownUsuario"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">

                        <!-- Avatar -->
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2"
                             style="width: 42px; height: 42px; font-family:'Oswald',sans-serif; font-weight:600;">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <!-- Nombre y correo -->
                        <div class="d-none d-lg-block text-start">
                            <div style="font-family:'Oswald',sans-serif; font-weight:600; letter-spacing:1px; color:#EFF1ED;">
                                @nombre @primerApellido @segundoApellido
                            </div>
                            <div class="text-muted" style="font-size: 0.78rem; color:#EFF1ED;">
                                @email
                            </div>
                            <div class="text-muted" style="font-size: 0.7rem; color:#FFD700;">
                                Rol: @(idRol == 1 ? "Administrador" : "Cliente")
                            </div>
                        </div>
                    </a>

                    <!-- Opciones -->
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="dropdownUsuario">
                        <li>
                            <a class="dropdown-item" asp-action="GestionPerfil" asp-controller="Home">
                                <i class="bi bi-pencil-square me-2"></i>
                                Editar información
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <a class="dropdown-item text-danger" asp-action="CerrarSesion" asp-controller="Home">
                                <i class="bi bi-box-arrow-right me-2"></i>
                                Cerrar sesión
                            </a>
                        </li>
                    </ul>

                </div>
            }
            else
            {

                <div class="d-flex align-items-center ms-4 py-3 py-lg-0 me-5">
                    <a asp-action="IniciarSesion" asp-controller="Home" class="btn btn-outline-light btn-sm me-2 px-3" style="font-family:'Oswald',sans-serif;font-weight:600;letter-spacing:1px;">
                        <i class="bi bi-person me-1"></i>Iniciar Sesión
                    </a>
                    <a asp-action="RegistrarUsuario" asp-controller="Home" class="btn btn-primary btn-sm px-3" style="font-family:'Oswald',sans-serif;font-weight:600;letter-spacing:1px;">
                        <i class="bi bi-person-plus me-1"></i>Registrarse
                    </a>
                </div>
            }
            <!-- Opciones de usuario FIN-->

        </div>
    </nav>
    <!-- Navbar End -->


    <div id="contentRendered">

        @RenderBody()

    </div>

    <!-- Footer Start -->
    <div class="container-fluid bg-img text-secondary" style="margin-top: 90px">
        <div class="container">
            <div class="row gx-5">
                <div class="col-lg-4 col-md-6 mb-5">
                    <div class="d-flex flex-column align-items-center justify-content-center text-center h-100 bg-primary border-inner p-4">
                        <a href="index.html" class="navbar-brand">
                            <h1 class="m-0 text-uppercase text-white"><i class="fa fa-birthday-cake fs-1 text-dark me-3"></i>RF Bakery</h1>
                        </a>
                        <p class="mt-3">
                            RF Bakery es el lugar donde cada postre se prepara con pasión, calidad y el auténtico sabor casero que tanto gusta en Lima.
                            Disfruta de deliciosas tortas, cupcakes, bocaditos y repostería artesanal elaborada con ingredientes seleccionados para hacer de cada ocasión un momento especial.
                            ¡Endulza tu día con RF Bakery!
                        </p>
                    </div>
                </div>
                <div class="col-lg-8 col-md-6">
                    <div class="row gx-5">
                        <div class="col-lg-4 col-md-12 pt-5 mb-5">
                            <h4 class="text-primary text-uppercase mb-4">Ponte en contacto</h4>
                            <div class="d-flex mb-2">
                                <i class="bi bi-geo-alt text-primary me-2"></i>
                                <p class="mb-0">Costa Rica</p>
                            </div>
                            <div class="d-flex mb-2">
                                <i class="bi bi-envelope-open text-primary me-2"></i>
                                <p class="mb-0">rfbakery@example.com</p>
                            </div>
                            <div class="d-flex mb-2">
                                <i class="bi bi-telephone text-primary me-2"></i>
                                <p class="mb-0">+012 345 67890</p>
                            </div>
                            <div class="d-flex mt-4">
                                <a class="btn btn-lg btn-primary btn-lg-square border-inner rounded-0 me-2" href="#"><i class="fab fa-twitter fw-normal"></i></a>
                                <a class="btn btn-lg btn-primary btn-lg-square border-inner rounded-0 me-2" href="#"><i class="fab fa-facebook-f fw-normal"></i></a>
                                <a class="btn btn-lg btn-primary btn-lg-square border-inner rounded-0 me-2" href="#"><i class="fab fa-linkedin-in fw-normal"></i></a>
                            </div>
                        </div>
                        <div class="col-lg-4 col-md-12 pt-0 pt-lg-5 mb-5">
                            <h4 class="text-primary text-uppercase mb-4">Accesos Rapidos</h4>
                            <div class="d-flex flex-column justify-content-start">
                                <a class="text-secondary mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Inicio</a>
                                <a class="text-secondary mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Sobre nosotros</a>
                                <a class="text-secondary mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Nuestros productos</a>
                                <a class="text-secondary mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Conoce al equipo</a>
                                <a class="text-secondary" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Contactanos</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="container-fluid text-secondary py-4" style="background: #111111;">
        <div class="container text-center">
            <p class="mb-0">
                &copy; <a class="text-white border-bottom" href="#">RF Bakery</a>. Todos los derechos reservados.

                <!--/*** This template is free as long as you keep the footer author’s credit link/attribution link/backlink. If you'd like to use the template without the footer author’s credit link/attribution link/backlink, you can purchase the Credit Removal License from "https://htmlcodex.com/credit-removal". Thank you for your support. ***/-->
                Diseñado por <a class="text-white border-bottom" href="https://htmlcodex.com">HTML Codex</a>
            </p>
            <br>Distribuido por: <a class="border-bottom" href="https://themewagon.com" target="_blank">ThemeWagon</a>
        </div>
    </div>
    <!-- Footer End -->
    <!-- Back to Top -->
    <a href="#" class="btn btn-primary border-inner py-3 fs-4 back-to-top"><i class="bi bi-arrow-up"></i></a>


    <!-- JavaScript Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/easing/easing.min.js" asp-append-version="true"></script>
    <script src="~/lib/waypoints/waypoints.min.js" asp-append-version="true"></script>
    <script src="~/lib/counterup/counterup.min.js" asp-append-version="true"></script>
    <script src="~/lib/owlcarousel/owl.carousel.min.js" asp-append-version="true"></script>

    <!-- Template Javascript -->
    <script src="~/js/main.js" asp-append-version="true"></script>
</body>

</html>